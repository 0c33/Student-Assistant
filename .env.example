# Copy to .env and fill in. Never commit .env.

# Provider: openrouter | custom
SA_PROVIDER=openrouter
OPENROUTER_API_KEY=
SA_MODEL=google/gemma-4-31b-it:free
SA_SMALL_MODEL=google/gemma-4-26b-a4b-it:free          # summaries, LLM judge
SA_FALLBACKS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free

# Local engine (llama.cpp / vLLM / LM Studio), used when SA_PROVIDER=custom
# SA_BASE_URL=http://localhost:8080/v1
# SA_API_KEY=none
# SA_MODEL=<model name the server expects>

# The vault: every file tool is confined to it. Default: vault/ in this project (created on first run).
# SA_ROOT=~/Documents/LifeLogs
SA_TZ=Asia/Riyadh
SA_MAX_STEPS=20
SA_MAX_COST_USD=0.05             # per task; free models count tokens at 0
SA_MAX_TOKENS=150000             # per task, prompt + completion: stops a looping task on free models too
SA_MAX_RESULT_CHARS=4000         # longer tool results are cut, with a note
SA_CONTEXT_TOKENS=24000          # budget per request (system prompt + history), estimated at 3 chars/token
SA_MEMORY=inject                 # inject: MEMORY.MD in the system prompt · tool: the model reads it itself
SA_MEMORY_CAP=2200               # characters; MEMORY.MD writes beyond it are refused (merge or prune instead)
SA_TOOLS=local                   # local: tools in-process · mcp: from servers/vault_mcp.py over MCP (stdio)
SA_CACHE=1                       # replay identical requests from .sa/cache (saves free quota)
